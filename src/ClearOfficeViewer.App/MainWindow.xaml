<Window x:Class="ClearOfficeViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClearOffice Viewer"
        Width="1220"
        Height="780"
        MinWidth="840"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="Transparent"
        Foreground="{DynamicResource AppForegroundBrush}"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                        CornerRadius="8"
                        GlassFrameThickness="-1"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- 1. Native-style Titlebar -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
        <Image Source="pack://application:,,,/ClearOfficeViewer;component/Assets/ClearOfficeViewer.png" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="ClearOffice Viewer" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleDocumentText"
                   FontSize="12.5"
                   Opacity="0.68"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton"
                Style="{StaticResource CaptionButtonStyle}"
                Content="&#xE921;"
                ToolTip="Minimize"
                Click="MinimizeButton_Click" />
        <Button x:Name="MaximizeButton"
                Style="{StaticResource CaptionButtonStyle}"
                Content="&#xE922;"
                ToolTip="Maximize"
                Click="MaximizeButton_Click" />
        <Button x:Name="CloseButton"
                Style="{StaticResource CloseCaptionButtonStyle}"
                Content="&#xE8BB;"
                ToolTip="Close"
                Click="CloseButton_Click" />
      </StackPanel>
    </Grid>

    <!-- 2. Top Command Bar -->
    <Border Grid.Row="1"
            x:Name="CommandBarBorder"
            BorderThickness="0,0,0,1"
            BorderBrush="#1A808080"
            Padding="10,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FileMenuButton"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Content="File"
                  Click="FileMenuButton_Click"
                  ToolTip="File menu">
            <Button.ContextMenu>
              <ContextMenu x:Name="FileContextMenu" Placement="Bottom">
                <MenuItem Header="Open..." InputGestureText="Ctrl+O" Click="OpenMenu_Click" />
                <MenuItem x:Name="FileRecentSubMenu" Header="Recent Files" />
                <Separator />
                <MenuItem x:Name="MenuPrintItem" Header="Print..." InputGestureText="Ctrl+P" IsEnabled="False" Click="PrintButton_Click" />
                <MenuItem x:Name="MenuCloseDocItem" Header="Close Document" InputGestureText="Ctrl+W" IsEnabled="False" Click="CloseDocument_Click" />
                <Separator />
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="CloseButton_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <Button Style="{StaticResource ToolbarButtonStyle}" Click="OpenMenu_Click" ToolTip="Open file (Ctrl+O)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Open" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Style="{StaticResource ToolbarButtonStyle}" Click="TopRecent_Click" ToolTip="Recent files">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE81C;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Recent" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Style="{StaticResource ToolbarButtonStyle}" Click="TopSettings_Click" ToolTip="Application settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Contextual Document Viewing Actions -->
        <StackPanel x:Name="DocumentActionBar"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE71F;" FontSize="13" />
          </Button>
          <TextBlock x:Name="ToolbarZoomText"
                     Text="100%"
                     Width="44"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Opacity="0.85" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A3;" FontSize="13" />
          </Button>
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="Fit Width" Click="FitWidth_Click" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="Fit Page" Click="FitPage_Click" />

          <Border Width="1" Height="18" Background="#26808080" Margin="6,0" />

          <Button x:Name="FindButton" Style="{StaticResource ToolbarButtonStyle}" Click="FindButton_Click" ToolTip="Find in document (Ctrl+F)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBlock Text="Find" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="PrintButton" Style="{StaticResource ToolbarButtonStyle}" Click="PrintButton_Click" ToolTip="Print (Ctrl+P)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE749;" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBlock Text="Print" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="FavoriteToggleButton" Style="{StaticResource ToolbarButtonStyle}" Click="FavoriteToggle_Click" ToolTip="Pin to Favorites">
            <TextBlock x:Name="FavoriteGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE734;" FontSize="13" />
          </Button>

          <Button x:Name="PresentButton"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Visibility="Collapsed"
                  Click="PresentButton_Click"
                  ToolTip="Start Presentation Mode (F5)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBlock Text="Present" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 3. Main Body: Left Sidebar + Document / Page Content -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Minimal Navigation Sidebar -->
      <Grid Grid.Column="0" Margin="8,8,4,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="NavListBox"
                 Grid.Row="0"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionChanged="NavListBox_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Height" Value="36" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="Padding" Value="10,0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBd" Background="Transparent" CornerRadius="4">
                      <Grid>
                        <Border x:Name="ActiveIndicator"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0"
                                CornerRadius="1.5"
                                Background="{StaticResource BrandAccentBrush}"
                                Visibility="Collapsed" />
                        <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBd" Property="Background" Value="#12808080" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBd" Property="Background" Value="#1A808080" />
                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBoxItem Tag="Home">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="Home" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Recent">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE81C;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="Recent files" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Favorites">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE734;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="Favorites" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>

        <!-- Active document compact summary (shown only while viewing a file) -->
        <Border x:Name="ActiveDocSidebarBox"
                Grid.Row="1"
                Visibility="Collapsed"
                Margin="4,8,4,2"
                Padding="10,8"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="#1E808080"
                Background="#0D808080">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <Border Background="{StaticResource BrandAccentBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                <TextBlock x:Name="ActiveDocBadgeText" Foreground="White" FontSize="10" FontWeight="SemiBold" Text="PDF" />
              </Border>
              <TextBlock x:Name="ActiveDocNameText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="128" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Row="1"
                    Content="Close Document"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    Padding="8,3"
                    FontSize="11.5"
                    Click="CloseDocument_Click" />
          </Grid>
        </Border>
      </Grid>

      <!-- Main Content Surface (subtle native layer over Mica/Acrylic) -->
      <Border x:Name="ContentSurfaceBorder"
              Grid.Column="1"
              Margin="4,4,8,4"
              CornerRadius="6"
              BorderThickness="1"
              BorderBrush="#1A808080"
              Background="#59FFFFFF">
        <Grid>
          <!-- HOME VIEW -->
          <ScrollViewer x:Name="HomeView" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="32,28">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
              <TextBlock Text="ClearOffice Viewer" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Open PDF documents, Word files, PowerPoint presentations, and local HTML pages."
                         FontSize="13"
                         Opacity="0.72"
                         Margin="0,4,0,18" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Padding="16,8"
                        Background="{StaticResource BrandAccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="OpenMenu_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Open a document..." FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="or drag and drop a file anywhere onto this window"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="12.5"
                           Opacity="0.65" />
              </StackPanel>

              <TextBlock Text="Supported formats" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Border BorderBrush="#1C808080" BorderThickness="1" CornerRadius="4" Margin="0,0,0,24">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#14808080" BorderThickness="0,0,0,1" />
                  <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#14808080" BorderThickness="0,0,0,1" />
                  <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#14808080" BorderThickness="0,0,0,1" />

                  <TextBlock Grid.Row="0" Grid.Column="0" Padding="12,8" FontWeight="SemiBold" FontSize="12.5" Text="PDF" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Padding="12,8" FontSize="12.5" Opacity="0.75" Text=".pdf" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Padding="12,8" FontSize="12.5" Opacity="0.82" Text="Multi-page view, text selection, search, zoom, print" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Padding="12,8" FontWeight="SemiBold" FontSize="12.5" Text="Word Documents" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Padding="12,8" FontSize="12.5" Opacity="0.75" Text=".doc, .docx" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Padding="12,8" FontSize="12.5" Opacity="0.82" Text="Formatted paragraphs, headings, tables, images, page layout" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Padding="12,8" FontWeight="SemiBold" FontSize="12.5" Text="Presentations" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Padding="12,8" FontSize="12.5" Opacity="0.75" Text=".ppt, .pptx" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Padding="12,8" FontSize="12.5" Opacity="0.82" Text="Slide thumbnails, text, images, speaker notes, presentation mode" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Padding="12,8" FontWeight="SemiBold" FontSize="12.5" Text="Web Files" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Padding="12,8" FontSize="12.5" Opacity="0.75" Text=".html, .htm" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Padding="12,8" FontSize="12.5" Opacity="0.82" Text="Local HTML, CSS, and JavaScript rendering via WebView2" />
                </Grid>
              </Border>

              <TextBlock Text="Recent files" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock x:Name="HomeEmptyRecentText"
                         Text="No recently opened files yet."
                         FontSize="12.5"
                         Opacity="0.65"
                         Margin="0,2,0,0" />
              <ItemsControl x:Name="HomeRecentList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#16808080" BorderThickness="0,0,0,1" Padding="8,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="52" />
                          <ColumnDefinition Width="230" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="125" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#16808080" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding FormatBadge}" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                        <Button Grid.Column="1"
                                Content="{Binding FileName}"
                                HorizontalAlignment="Left"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                FontSize="12.5"
                                Cursor="Hand"
                                Tag="{Binding FilePath}"
                                Click="OpenRecentItem_Click" />
                        <TextBlock Grid.Column="2" Text="{Binding FilePath}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding FormattedLastOpened}" FontSize="11.5" Opacity="0.65" VerticalAlignment="Center" />
                        <Button Grid.Column="4"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Tag="{Binding FilePath}"
                                Click="ToggleRecentFavorite_Click"
                                ToolTip="Toggle favorite">
                          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" Text="&#xE734;" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- RECENT FILES VIEW -->
          <Grid x:Name="RecentView" Visibility="Collapsed" Margin="28,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
              <Button DockPanel.Dock="Right" Content="Clear Recent List" Padding="10,5" Click="ClearRecent_Click" />
              <TextBlock Text="Recent files" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListView x:Name="RecentListView"
                      Grid.Row="1"
                      Background="Transparent"
                      BorderBrush="#1C808080"
                      BorderThickness="1"
                      MouseDoubleClick="RecentListView_MouseDoubleClick">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Format" Width="74" DisplayMemberBinding="{Binding FormatBadge}" />
                  <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding FileName}" />
                  <GridViewColumn Header="Size" Width="88" DisplayMemberBinding="{Binding FormattedSize}" />
                  <GridViewColumn Header="Opened" Width="135" DisplayMemberBinding="{Binding FormattedLastOpened}" />
                  <GridViewColumn Header="Location" Width="400" DisplayMemberBinding="{Binding FilePath}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- FAVORITES VIEW -->
          <Grid x:Name="FavoritesView" Visibility="Collapsed" Margin="28,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Favorites" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
            <TextBlock x:Name="FavoritesEmptyText"
                       Grid.Row="1"
                       Text="No favorite files pinned yet. Open a document and click the star icon in the toolbar."
                       FontSize="13"
                       Opacity="0.68"
                       Margin="0,8,0,0" />
            <ListView x:Name="FavoritesListView"
                      Grid.Row="1"
                      Background="Transparent"
                      BorderBrush="#1C808080"
                      BorderThickness="1"
                      MouseDoubleClick="FavoritesListView_MouseDoubleClick">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Format" Width="74" DisplayMemberBinding="{Binding FormatBadge}" />
                  <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding FileName}" />
                  <GridViewColumn Header="Size" Width="88" DisplayMemberBinding="{Binding FormattedSize}" />
                  <GridViewColumn Header="Location" Width="460" DisplayMemberBinding="{Binding FilePath}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- SETTINGS VIEW -->
          <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel MaxWidth="740" HorizontalAlignment="Left">
              <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

              <TextBlock Text="Appearance" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Border BorderBrush="#1C808080" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                <StackPanel>
                  <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Window translucency material" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Uses native Windows 11 Desktop Window Manager backdrop composition" FontSize="11.5" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="BackdropCombo" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="BackdropCombo_SelectionChanged">
                      <ComboBoxItem Content="Mica (Default)" Tag="Mica" />
                      <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                      <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                      <ComboBoxItem Content="Solid" Tag="Solid" />
                    </ComboBox>
                  </Grid>

                  <Border Height="1" Background="#14808080" />

                  <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Application theme" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Match Windows theme or force Light / Dark appearance" FontSize="11.5" Opacity="0.68" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                      <ComboBoxItem Content="Use system setting" Tag="System" />
                      <ComboBoxItem Content="Light" Tag="Light" />
                      <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Text="Document Viewing" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Border BorderBrush="#1C808080" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                <StackPanel>
                  <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Default zoom mode" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Applied automatically when opening documents" FontSize="11.5" Opacity="0.68" />
                    </StackPanel>
                    <ComboBox x:Name="DefaultZoomCombo" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="DefaultZoomCombo_SelectionChanged">
                      <ComboBoxItem Content="Fit Width" Tag="FitWidth" />
                      <ComboBoxItem Content="Fit Page" Tag="FitPage" />
                      <ComboBoxItem Content="100% Actual Size" Tag="ActualSize" />
                    </ComboBox>
                  </Grid>

                  <Border Height="1" Background="#14808080" />

                  <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Show bottom status bar" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Displays page/slide progress and zoom level" FontSize="11.5" Opacity="0.68" />
                    </StackPanel>
                    <CheckBox x:Name="ShowStatusBarCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="ShowStatusBarCheckBox_Changed" Unchecked="ShowStatusBarCheckBox_Changed" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Text="Windows File Associations" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Border BorderBrush="#1C808080" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                <StackPanel Margin="16,12">
                  <TextBlock Text="Supported extensions: .pdf, .doc, .docx, .ppt, .pptx, .html, .htm" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock x:Name="FileAssocStatusText" FontSize="12" Opacity="0.72" Margin="0,4,0,12" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Register Open With Associations" Padding="12,6" Margin="0,0,8,0" Click="RegisterAssociations_Click" />
                    <Button Content="Unregister" Padding="12,6" Margin="0,0,8,0" Click="UnregisterAssociations_Click" />
                    <Button Content="Open Windows Default Apps" Padding="12,6" Click="OpenWindowsDefaultApps_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Text="About" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Border BorderBrush="#1C808080" BorderThickness="1" CornerRadius="4">
                <Grid Margin="16,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ClearOffice Viewer 1.0.0" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Lightweight native Windows 11 office document viewer · MIT License" FontSize="11.5" Opacity="0.68" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Open Logs Folder" Padding="12,6" VerticalAlignment="Center" Click="OpenLogsFolder_Click" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ACTIVE DOCUMENT VIEWER HOST -->
          <ContentControl x:Name="ViewerHost" Visibility="Collapsed" />

          <!-- LOADING OVERLAY -->
          <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#33000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,14" CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="#26808080" BorderThickness="1">
              <TextBlock x:Name="LoadingMessageText" Text="Opening file..." FontSize="13" />
            </Border>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- 4. Bottom Status Bar -->
    <Border x:Name="StatusBarBorder"
            Grid.Row="3"
            BorderThickness="0,1,0,0"
            BorderBrush="#18808080"
            Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusLeftText"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="11.5"
                   Opacity="0.78"
                   Text="Ready"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="StatusRightPrimaryText"
                     FontSize="11.5"
                     Opacity="0.85"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="StatusZoomSeparator"
                     Text="   |   "
                     FontSize="11.5"
                     Opacity="0.45"
                     Visibility="Collapsed"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="StatusZoomText"
                     FontSize="11.5"
                     Opacity="0.85"
                     Visibility="Collapsed"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
