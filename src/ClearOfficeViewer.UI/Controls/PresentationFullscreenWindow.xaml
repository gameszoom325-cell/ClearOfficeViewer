<Window x:Class="ClearOfficeViewer.UI.Controls.PresentationFullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#0D0D0D"
        KeyDown="Window_KeyDown">
  <Grid>
    <Viewbox x:Name="FullscreenViewbox"
             Stretch="Uniform"
             MouseLeftButtonUp="FullscreenViewbox_MouseLeftButtonUp" />

    <!-- Subtle bottom-left theater navigation bar -->
    <Border HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="20"
            Padding="10,6"
            CornerRadius="6"
            Background="#CC1F1F1F"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <Button Content="Previous" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,4" Click="Prev_Click" />
        <TextBlock x:Name="CounterText"
                   Foreground="#E5E7EB"
                   VerticalAlignment="Center"
                   Margin="10,0"
                   FontSize="12" />
        <Button Content="Next" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,4" Click="Next_Click" />
        <Button Content="Exit (Esc)" Foreground="#D1D5DB" Background="Transparent" BorderThickness="0" Padding="10,4,6,4" Click="Exit_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
