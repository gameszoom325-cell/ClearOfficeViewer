<UserControl x:Class="ClearOfficeViewer.UI.Controls.DocumentViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True">
  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    <CommandBinding Command="ApplicationCommands.Print" Executed="OnPrintExecuted" />
  </UserControl.CommandBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="FindBar"
            Grid.Row="0"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            Margin="0,8,20,4"
            Padding="8,6"
            CornerRadius="6"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="FindTextBox"
                 Width="210"
                 VerticalContentAlignment="Center"
                 Padding="8,4"
                 KeyDown="FindTextBox_KeyDown"
                 TextChanged="FindTextBox_TextChanged" />
        <TextBlock x:Name="FindCountText"
                   VerticalAlignment="Center"
                   Margin="8,0"
                   FontSize="12"
                   Opacity="0.75"
                   Text="0 / 0" />
        <Button Content="Prev" Padding="8,4" Margin="2,0" Click="FindPrev_Click" />
        <Button Content="Next" Padding="8,4" Margin="2,0" Click="FindNext_Click" />
        <Button Content="Close" Padding="8,4" Margin="6,0,0,0" Click="FindClose_Click" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="OuterScrollViewer"
                  Grid.Row="1"
                  Background="Transparent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  ScrollChanged="OuterScrollViewer_ScrollChanged"
                  PreviewMouseWheel="OuterScrollViewer_PreviewMouseWheel">
      <Border x:Name="PaperSheetBorder"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="24,18,24,28"
              Background="White"
              BorderBrush="#D0D7DE"
              BorderThickness="1"
              CornerRadius="2">
        <Border.LayoutTransform>
          <ScaleTransform x:Name="PaperScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <RichTextBox x:Name="DocRichTextBox"
                     IsReadOnly="True"
                     IsDocumentEnabled="True"
                     BorderThickness="0"
                     Background="White"
                     Padding="0"
                     VerticalScrollBarVisibility="Disabled"
                     HorizontalScrollBarVisibility="Disabled" />
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
