<UserControl x:Class="ClearOfficeViewer.UI.Controls.PdfViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True">
  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyExecuted" CanExecute="OnCopyCanExecute" />
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    <CommandBinding Command="ApplicationCommands.Print" Executed="OnPrintExecuted" />
  </UserControl.CommandBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Compact inline Find bar (Ctrl+F) -->
    <Border x:Name="FindBar"
            Grid.Row="0"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            Margin="0,8,20,4"
            Padding="8,6"
            CornerRadius="6"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="FindTextBox"
                 Width="210"
                 VerticalContentAlignment="Center"
                 Padding="8,4"
                 KeyDown="FindTextBox_KeyDown"
                 TextChanged="FindTextBox_TextChanged" />
        <TextBlock x:Name="FindCountText"
                   VerticalAlignment="Center"
                   Margin="8,0"
                   FontSize="12"
                   Opacity="0.75"
                   Text="0 / 0" />
        <Button Content="Prev" Padding="8,4" Margin="2,0" Click="FindPrev_Click" />
        <Button Content="Next" Padding="8,4" Margin="2,0" Click="FindNext_Click" />
        <Button Content="Close" Padding="8,4" Margin="6,0,0,0" Click="FindClose_Click" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="MainScrollViewer"
                  Grid.Row="1"
                  Background="Transparent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  ScrollChanged="MainScrollViewer_ScrollChanged"
                  PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
      <ScrollViewer.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy Selected Text" InputGestureText="Ctrl+C" Click="CopyMenuItem_Click" />
          <MenuItem Header="Clear Selection" Click="ClearSelectionMenuItem_Click" />
          <Separator />
          <MenuItem Header="Find in PDF..." InputGestureText="Ctrl+F" Click="FindMenuItem_Click" />
          <MenuItem Header="Print..." InputGestureText="Ctrl+P" Click="PrintMenuItem_Click" />
        </ContextMenu>
      </ScrollViewer.ContextMenu>
      <StackPanel x:Name="PagesPanel"
                  HorizontalAlignment="Center"
                  Margin="24,16,24,24" />
    </ScrollViewer>
  </Grid>
</UserControl>
