<UserControl x:Class="ClearOfficeViewer.UI.Controls.PresentationViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="178" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Slide Order Thumbnail Strip -->
    <Border Grid.Column="0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Background="Transparent">
      <ListBox x:Name="SlideThumbList"
               Background="Transparent"
               BorderThickness="0"
               Padding="8"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="SlideThumbList_SelectionChanged">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,8" />
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </Border>

    <!-- Main Slide Stage + Optional Speaker Notes -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer x:Name="SlideScrollViewer"
                    Grid.Row="0"
                    Background="Transparent"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    PreviewMouseWheel="SlideScrollViewer_PreviewMouseWheel">
        <Border x:Name="SlideStageFrame"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Background="White"
                CornerRadius="2">
          <Viewbox x:Name="SlideStageViewbox" Stretch="Uniform" />
        </Border>
      </ScrollViewer>

      <Border x:Name="NotesBar"
              Grid.Row="1"
              Visibility="Collapsed"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,8"
              MaxHeight="110">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="NotesTextBlock"
                     TextWrapping="Wrap"
                     FontSize="12.5"
                     Opacity="0.85" />
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
