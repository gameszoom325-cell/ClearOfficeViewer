<UserControl x:Class="ClearOfficeViewer.UI.Controls.HtmlViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="FindBar"
            Grid.Row="0"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            Margin="0,8,20,4"
            Padding="8,6"
            CornerRadius="6"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="FindTextBox"
                 Width="210"
                 VerticalContentAlignment="Center"
                 Padding="8,4"
                 KeyDown="FindTextBox_KeyDown" />
        <Button Content="Find Next" Padding="8,4" Margin="6,0,0,0" Click="FindNext_Click" />
        <Button Content="Close" Padding="8,4" Margin="6,0,0,0" Click="FindClose_Click" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="16,12,16,16"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True"
            Background="White">
      <wv2:WebView2 x:Name="WebView" />
    </Border>
  </Grid>
</UserControl>
